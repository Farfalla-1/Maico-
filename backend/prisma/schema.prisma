generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Unit {
  KG
  G
  L
  ML
  UNIT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id           Int                @id @default(autoincrement())
  name         String
  unit         Unit
  price        Decimal
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  priceHistory PriceHistory[]
  recipes      RecipeIngredient[]
  stockItems   StockItem[]
}

model PriceHistory {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  price        Decimal
  recordedAt   DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Recipe {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  image       String?
  yield       Int
  yieldUnit   String
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  stockItems  StockItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecipeStep {
  id          Int    @id @default(autoincrement())
  recipeId    Int
  stepNumber  Int
  description String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
}

model FixedCost {
  id          Int      @id @default(autoincrement())
  name        String
  amount      Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum StockType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum MovementType {
  IN
  OUT
}

model LedgerEntry {
  id             Int                @id @default(autoincrement())
  type           LedgerType
  description    String
  amount         Decimal
  date           DateTime
  category       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stockMovements StockMovement[]
  saleItems      LedgerSaleItem[]
  extraCharges   LedgerExtraCharge[]
}

model LedgerSaleItem {
  id            Int         @id @default(autoincrement())
  ledgerEntryId Int
  stockItemId   Int
  quantity      Decimal
  deductStock   Boolean     @default(true)
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  stockItem     StockItem   @relation(fields: [stockItemId], references: [id])
}

model LedgerExtraCharge {
  id            Int         @id @default(autoincrement())
  ledgerEntryId Int
  description   String
  amount        Decimal
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Decimal
  unit         Unit
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model StockItem {
  id           Int             @id @default(autoincrement())
  type         StockType
  name         String
  ingredientId Int?
  recipeId     Int?
  unit         String
  currentStock Decimal         @default(0)
  ingredient   Ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipe       Recipe?         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  saleItems    LedgerSaleItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([type, ingredientId])
  @@unique([type, recipeId])
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  stockItemId   Int
  movementType  MovementType
  quantity      Decimal
  reason        String
  ledgerEntryId Int?
  stockItem     StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  ledgerEntry   LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}
